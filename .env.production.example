# Production environment template for test-api on AWS EC2.
#
# Copy this to `.env` ON THE SERVER, then replace every <PLACEHOLDER>.
# Never commit the filled-in version -- .gitignore already covers .env
# and .env.production.
#
#   cp .env.production.example .env
#   nano .env
#   php artisan key:generate
#   php artisan config:cache
#
# Remember: after ANY change to .env you must re-run `php artisan config:cache`,
# or Laravel will keep reading the old cached values.

APP_NAME=Laravel
APP_ENV=production
# Leave APP_KEY empty and run `php artisan key:generate` on the server.
# Do not reuse the key from your local .env.
APP_KEY=

# MUST be false. With true, error pages publicly dump stack traces,
# file paths, and the full contents of this file -- including DB credentials.
APP_DEBUG=false

APP_URL=https://<your-domain.com>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` floods the disk in production.
LOG_LEVEL=error

# RDS PostgreSQL. DB_HOST is the endpoint hostname from the RDS console --
# it looks like: test-api-db.abc123xyz.us-east-1.rds.amazonaws.com
DB_CONNECTION=pgsql
DB_HOST=<your-rds-endpoint>.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=test_api
DB_USERNAME=postgres
DB_PASSWORD=<your-rds-master-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to your domain once you have one, e.g. .your-domain.com
SESSION_DOMAIN=null
# Cookies over HTTPS only. Requires Step 8 (certbot) to be done first.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Single-instance setup uses the `database` drivers above. When you move to
# ElastiCache, point these at the Redis endpoint and switch
# SESSION_DRIVER / CACHE_STORE / QUEUE_CONNECTION to `redis`.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs instead of sending it. Swap to ses/smtp
# when you actually need delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@<your-domain.com>"
MAIL_FROM_NAME="${APP_NAME}"

# LEAVE THE KEY AND SECRET EMPTY. Attach an IAM role to the EC2 instance
# instead -- the SDK picks up credentials from instance metadata automatically,
# and there is nothing on disk to leak.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
